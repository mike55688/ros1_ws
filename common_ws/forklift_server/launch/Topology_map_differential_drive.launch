<launch>

<arg name="robot_pose" default="/robot_pose"/>
<node pkg="forklift_server" type="publisher_robot_pose.py" name="Robot_pose" output="screen">
    <param name="publish_name" value="$(arg robot_pose)" />
    <param name="rate" type="int" value="10" />
</node>


<node pkg="forklift_server" type="Topology_map_server.py" name="TopologyMap_server" output="screen">
    <param name="odom" value="$(arg robot_pose)" /><!--里程計 Topic（map -> base_link, 是tf相對關係, 非輪式里程計）/-->
    <param name="start_node" value="P1" />
    <rosparam param= "graph">
    {
        "P1": {"P2": 1},
        "P2": {"P3": 1},
        "P3": {"P3": 1}

    }
    </rosparam>
    <rosparam param= "waypoints">
    {    

        <!-- 晚上 one tree -->
        <!-- "P1": [3.398, -0.055, -0.008, 1.000],
        "P2": [3.398, -0.055, -0.710, 0.704],
        "P3": [3.321, -3.682, -0.709, 0.705], -->

        <!-- 晚上 two tree  -->
        <!-- "P1": [3.608, -0.122, -0.004, 1.000],
        "P2": [3.608, -0.122, -0.700, 0.715],
        "P3": [3.577, -3.608, -0.696, 0.718] -->

        <!-- 下午4點 two tree  -->
        "P1": [3.344, -0.128, 0.002, 1.000],
        "P2": [3.344, -0.128, -0.699, 0.716],
        "P3": [3.317, -3.578, -0.701, 0.713]
    }
    </rosparam>
</node>
</launch>

